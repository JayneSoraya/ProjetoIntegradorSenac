  "scripts": {
    "dev": "ts-node-dev --transpile-only --ignore-watch node_modules src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "migrate": "ts-node-dev --transpile-only --exit-child src/scripts/migrate.ts",
    "test": "npm run build && node --test \"dist/**/*.test.js\"",
    "migrate:prod": "node dist/scripts/migrate.js",
    "seed:accounts": "ts-node-dev --transpile-only --exit-child src/scripts/seedDemoAccounts.ts",
    "seed:accounts:prod": "node dist/scripts/seedDemoAccounts.js",
    "seed:demo": "ts-node-dev --transpile-only --exit-child src/scripts/seedDemoData.ts",
    "seed:demo:prod": "node dist/scripts/seedDemoData.js"
  },
  "keywords": [],
