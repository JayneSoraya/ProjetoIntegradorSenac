NODE_ENV=development
PORT=3333

# Copie a connection string do Neon. Nao versione credenciais reais.
# A documentacao atual do Neon recomenda TLS e hoje inclui sslmode=require
# e channel_binding=require nos snippets de conexao.
DATABASE_URL=postgresql://usuario:senha@host/database?sslmode=require&channel_binding=require
DATABASE_POOL_MAX=10

# Número de proxies reversos confiáveis entre cliente e Express. Local direto = 0.
TRUST_PROXY_HOPS=0

# Gere um segredo aleatorio forte. Minimo aceito pela aplicacao: 32 caracteres.
JWT_SECRET=troque-por-um-segredo-aleatorio-com-mais-de-32-caracteres
JWT_ISSUER=econoway-api
JWT_AUDIENCE=econoway-clients
JWT_EXPIRES_IN_SECONDS=604800

# Precos mais antigos continuam visiveis, mas sao sinalizados como desatualizados.
PRICE_FRESHNESS_HOURS=168

# Origens do navegador separadas por virgula. Apps mobile normalmente nao enviam Origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hosts oficiais aceitos para leitura de QR Code NFC-e SP.
NFCE_ALLOWED_HOSTS=www.nfce.fazenda.sp.gov.br,www.homologacao.nfce.fazenda.sp.gov.br

# Opcional: contas de demonstração em banco local/descartável. Nunca use senhas reais aqui.
DEMO_ADMIN_EMAIL=admin-demo@example.invalid
DEMO_ADMIN_PASSWORD=defina-uma-senha-forte-local
DEMO_ADMIN_NAME=Administrador Demo
DEMO_MARKET_EMAIL=mercado-demo@example.invalid
DEMO_MARKET_PASSWORD=defina-uma-senha-forte-local
DEMO_MARKET_NAME=Responsável Mercado Demo
