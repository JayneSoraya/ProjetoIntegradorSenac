# Apenas para ambiente local descartável. Não reutilize estas credenciais fora dele.
POSTGRES_DB=econoway
POSTGRES_USER=econoway
POSTGRES_PASSWORD=troque-a-senha-local-do-postgres
JWT_SECRET=troque-por-um-segredo-local-com-pelo-menos-32-caracteres
DEMO_USER_EMAIL=usuario-demo@econoway.local
DEMO_USER_PASSWORD=troque-a-senha-demo-usuario
DEMO_ADMIN_EMAIL=admin-demo@econoway.local
DEMO_ADMIN_PASSWORD=troque-a-senha-demo-admin
DEMO_MARKET_EMAIL=mercado-demo@econoway.local
DEMO_MARKET_PASSWORD=troque-a-senha-demo-mercado

# Compose expõe a API diretamente no host; não há proxy HTTP na frente dela.
TRUST_PROXY_HOPS=0
